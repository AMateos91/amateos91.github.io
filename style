/* =========================
   GENERAL STYLES
========================= */

body {
  font-family: Arial, Helvetica, sans-serif;
  margin: 20px;
  background-color: #ffffff;
  color: #222;
}

h1 {
  text-align: center;
  margin-bottom: 25px;
}

h2 {
  margin-top: 40px;
  color: #333;
}

/* =========================
   HOME PAGE - NUMBER BLOCKS
========================= */

.numbers {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-bottom: 30px;
}

.num {
  width: 65px;
  height: 65px;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 20px;
  font-weight: bold;
  color: white;
  text-decoration: none;
  transition: all 0.3s ease;
}

.num:hover {
  transform: scale(1.15);
  opacity: 0.85;
  cursor: pointer;
}

/* Colors */
.n1 { background-color: tomato; }
.n2 { background-color: steelblue; }
.n3 { background-color: limegreen; }
.n4 { background-color: orange; }

/* =========================
   LIST STYLING
========================= */

ol {
  font-weight: bold;
  margin-left: 20px;
}

ul {
  font-weight: normal;
  color: #555;
}

/* =========================
   LINKS
========================= */

a {
  color: #1a73e8;
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

/* =========================
   TABLE STYLES (TRAVEL STORIES)
========================= */

table {
  width: 80%;
  margin: 0 auto;
  border-collapse: collapse;
  margin-top: 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

th {
  background-color: #f2f2f2;
  padding: 12px;
  border: 1px solid #ccc;
  font-size: 16px;
}

td {
  text-align: center;
  padding: 20px;
  border: 1px solid #ddd;
  vertical-align: middle;
}

/* Zebra rows */
tr:nth-child(even) {
  background-color: #fafafa;
}

/* =========================
   IMAGES (HOVER EFFECTS)
========================= */

img {
  width: 180px;
  height: 120px;
  object-fit: cover;
  border-radius: 10px;
  transition: all 0.3s ease;
}

img:hover {
  opacity: 0.7;
  transform: scale(1.05);
}

/* =========================
   SECTIONS (BOTTOM INFO)
========================= */

section {
  max-width: 800px;
  margin: 40px auto;
  padding: 10px 20px;
}

section p {
  line-height: 1.6;
  color: #444;
}

/* =========================
   HORIZONTAL LINE
========================= */

hr {
  margin: 30px 0;
  border: 0;
  height: 1px;
  background: #ddd;
}
